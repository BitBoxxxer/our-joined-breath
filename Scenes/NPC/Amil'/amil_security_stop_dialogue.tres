[gd_resource type="Resource" script_class="DialogueTree" format=3 uid="uid://bp3k7vm2m115f"]

[ext_resource type="Script" uid="uid://2w76lox8smnc" path="res://Scripts/Dialogue/DialogueTree.gd" id="1_tree"]
[ext_resource type="Script" uid="uid://b6y454j4dgsgo" path="res://Scripts/Dialogue/DialogueLine.gd" id="2_line"]
[ext_resource type="Script" uid="uid://oyberqfdag46" path="res://Scripts/Dialogue/DialogueChoice.gd" id="2_yt3mw"]

[sub_resource type="Resource" id="Line_stop"]
script = ExtResource("2_line")
speaker = "Амиль"
text = "Стоп. Незапланированное перемещение вне разрешённых маршрутов."

[sub_resource type="Resource" id="Line_player_rush"]
script = ExtResource("2_line")
text = "Амиль, пожалуйста, не сейчас! Там появилась новая игра — про рыцаря!"

[sub_resource type="Resource" id="Line_amil_warn"]
script = ExtResource("2_line")
speaker = "Амиль"
text = "Новые процессы нестабильны первые циклы. Вмешательство до инициализации запрещено протоколом."

[sub_resource type="Resource" id="Line_amil_let_go"]
script = ExtResource("2_line")
speaker = "Амиль"
text = "...Однако прямого запрета на наблюдение не зафиксировано. Иди. Но без вмешательства."
set_flags = {
"amil_allowed_knight_visit": true
}

[resource]
script = ExtResource("1_tree")
lines = Array[ExtResource("2_line")]([SubResource("Line_stop"), SubResource("Line_player_rush"), SubResource("Line_amil_warn"), SubResource("Line_amil_let_go")])
