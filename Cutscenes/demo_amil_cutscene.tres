[gd_resource type="Resource" script_class="CutsceneSequence" format=3 uid="uid://dx1nlb4jqp8ku"]

[ext_resource type="Script" uid="uid://cxl3m0whevp1p" path="res://Scripts/Cutscene/CutsceneSequence.gd" id="1_seq"]
[ext_resource type="Script" uid="uid://dwvbbboaltrdg" path="res://Scripts/Cutscene/CutsceneAction.gd" id="2_act"]
[ext_resource type="Resource" uid="uid://c1jb1o0731mrj" path="res://Scenes/NPC/Amil'/amil_dialogue.tres" id="3_dlg"]

[sub_resource type="Resource" id="Action_shot1"]
script = ExtResource("2_act")
type = 0
camera_position = Vector3(2, 2.6, -2)
camera_look_at_point = Vector3(0, 2, -5)
camera_duration = 1.2
camera_fov = 50.0

[sub_resource type="Resource" id="Action_caption1"]
script = ExtResource("2_act")
type = 6
caption_text = "Ты подходишь к Амилю..."
caption_duration = 2.0

[sub_resource type="Resource" id="Action_qte"]
script = ExtResource("2_act")
type = 3
qte_prompt = "Быстро нажми E!"
qte_success_next_index = 4
qte_fail_next_index = 3

[sub_resource type="Resource" id="Action_caption_fail"]
script = ExtResource("2_act")
type = 6
caption_text = "Ты замешкался..."
caption_duration = 1.5

[sub_resource type="Resource" id="Action_shot2"]
script = ExtResource("2_act")
type = 0
camera_position = Vector3(-2, 2.6, -2.5)
camera_look_at_point = Vector3(0, 2, -5)
camera_fov = 50.0

[sub_resource type="Resource" id="Action_dialogue"]
script = ExtResource("2_act")
type = 2
dialogue = ExtResource("3_dlg")

[resource]
script = ExtResource("1_seq")
sequence_name = "Демо: встреча с Амилем"
actions = Array[ExtResource("2_act")]([SubResource("Action_shot1"), SubResource("Action_caption1"), SubResource("Action_qte"), SubResource("Action_caption_fail"), SubResource("Action_shot2"), SubResource("Action_dialogue")])
